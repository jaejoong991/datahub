PORT=3000
# Port 5434 = Postgres dari compose.yaml di root repo (`docker compose up -d`).
DATABASE_URL=postgres://datahub:datahub@localhost:5434/datahub
# Wajib >= 32 karakter. Nilai di bawah SENGAJA sama dengan default dev di env.ts
# supaya server menolak start kalau nilai ini kebawa ke production.
# Generate yang asli: openssl rand -hex 32
ENCRYPTION_KEY=dev-encryption-key-32-bytes-long!!
CORS_ORIGIN=http://localhost:5173
# Base URL publik backend sendiri (bukan frontend) — dipakai untuk redirect_uri OAuth Shopee.
APP_URL=http://localhost:3000

# Password admin hasil `npm run seed` (dev only). Kosongkan untuk password random
# yang di-generate dan di-log sekali saat seed jalan.
# SEED_PASSWORD=

# Shopee bootstrap (opsional — seed baca dari sini lalu pindah ke DB)
# Setelah credential di DB, admin kelola via panel. Kosongi jika sudah ada.
# SHOPEE_PARTNER_ID=
# SHOPEE_PARTNER_KEY=
# SHOPEE_SANDBOX=true
